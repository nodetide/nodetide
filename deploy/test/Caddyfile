# Used by the optional "edge" profile. *_SITE are host names (automatic HTTPS) or http://host:port (local testing).
{$NODE_SITE} {
	reverse_proxy node:4557
}

{$RP_SITE} {
	reverse_proxy rp:4180
}

# No public wallet: the Nodetide web client served by the node is the wallet (keys stay in the browser). The old
# server-side test wallet is the opt-in `hosted-wallet` profile and is reachable only on 127.0.0.1:4572 (ssh tunnel).

{$GRAFANA_SITE} {
	reverse_proxy grafana:3000
}

{$VERIFIER_SITE} {
	reverse_proxy verifier:4558
}
